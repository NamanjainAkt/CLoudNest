# CloudNest Environment Configuration
# Copy this file to .env and fill in your values

# Telegram MTProto API Credentials
# Obtain these from: https://my.telegram.org/apps
EXPO_PUBLIC_TELEGRAM_API_ID=
EXPO_PUBLIC_TELEGRAM_API_HASH=

# Default Active Telegram Data Center
# 1 = Miami (US), 2 = Amsterdam (NL), 4 = Frankfurt (DE - Default), 5 = Singapore (SG)
EXPO_PUBLIC_TELEGRAM_DC_ID=4
